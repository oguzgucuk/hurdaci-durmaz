---
import company from '../data_files/company.json';

const currentPath = Astro.url.pathname;
const callUrl = `tel:${company.phoneRaw}`;
const waUrl = `https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(company.defaultWhatsAppMessage)}`;

const navLinks = [
  { href: '/', label: 'Ana Sayfa' },
  { href: '/hurda-cesitleri', label: 'Hurda Çeşitleri' },
  { href: '/ikinci-el-klima-kombi', label: '2. El Klima & Kombi', highlight: true },
  { href: '/hizmetler', label: 'Hizmetlerimiz' },
  { href: '/hakkimizda', label: 'Hakkımızda' },
  { href: '/iletisim', label: 'İletişim' },
];
---

<header class="sticky top-0 z-50 w-full bg-slate-950/95 backdrop-blur-md text-white border-b border-white/10 shadow-md">
  <!-- TopBar: Service Notice & Instant Access -->
  <div class="bg-slate-900/90 border-b border-white/10 py-2 text-xs text-slate-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-wrap items-center justify-between gap-y-2">
      <!-- Left Live Notice -->
      <div class="flex items-center gap-2 font-medium">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-white font-semibold">İstanbul Geneli & Gebze:</span>
        <span class="text-slate-300 hidden sm:inline">Adresten Hassas Dijital Tartım ile Kapıda Peşin Ödeme</span>
      </div>

      <!-- Right Contacts -->
      <div class="flex items-center gap-4 sm:gap-6 ml-auto">
        <!-- Working Hours Note -->
        <span class="hidden lg:flex items-center gap-1.5 text-slate-300 text-xs">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{company.workingHours.weekdays} (Adres Alımı 7/24)</span>
        </span>

        <!-- WhatsApp Quick Link -->
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-emerald-400 hover:text-emerald-300 font-bold transition-colors"
          aria-label="WhatsApp İletişim"
        >
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.34C9.36 7.34 9.09 7.4 8.87 7.65C8.64 7.89 8 8.49 8 9.72C8 10.95 8.89 12.14 9.01 12.31C9.14 12.47 10.77 14.97 13.25 16.05C13.84 16.31 14.3 16.46 14.66 16.58C15.26 16.77 15.8 16.74 16.24 16.68C16.73 16.61 17.74 16.07 17.95 15.48C18.16 14.89 18.16 14.38 18.1 14.28C18.04 14.18 17.88 14.12 17.64 14C17.4 13.88 16.21 13.3 15.99 13.22C15.77 13.14 15.61 13.1 15.45 13.34C15.29 13.59 14.83 14.12 14.69 14.28C14.55 14.44 14.41 14.47 14.17 14.35C13.93 14.23 12.92 13.89 11.72 12.82C10.79 11.99 10.16 10.96 10.04 10.76C9.92 10.56 10.03 10.45 10.15 10.33C10.26 10.22 10.4 10.04 10.52 9.9C10.64 9.76 10.68 9.66 10.76 9.5C10.84 9.34 10.8 9.2 10.74 9.08C10.68 8.96 10.22 7.83 10.03 7.37C9.84 6.92 9.65 6.98 9.53 7.34Z"/>
          </svg>
          <span class="hidden sm:inline">WhatsApp</span>
        </a>

        <!-- Direct Phone Call Link -->
        <a
          href={callUrl}
          class="flex items-center gap-1.5 text-amber-400 hover:text-amber-300 font-bold transition-colors"
          aria-label={`Telefon: ${company.phone}`}
        >
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>{company.phone}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar: 72px -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-18 sm:h-20">
      
      <!-- Logo: Clean Industrial Brand -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="Hurdacı Durmaz Metal Ana Sayfa">
        <div class="w-10 h-10 rounded-lg bg-slate-900 border border-white/20 flex items-center justify-center shrink-0 group-hover:border-amber-400 group-hover:bg-slate-800 transition-colors shadow-sm">
          <svg class="w-6 h-6 text-amber-400" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <path d="M24 6V16M24 16C18.4772 16 14 20.4772 14 26C14 31.5228 18.4772 36 24 36C27.3137 36 30.25 34.39 32.08 31.89" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
            <circle cx="24" cy="10" r="3" fill="currentColor"/>
            <rect x="28" y="24" width="12" height="6" rx="2" fill="#ea580c"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-lg sm:text-xl font-extrabold tracking-tight text-white leading-tight font-display">
            HURDACI <span class="text-amber-400">DURMAZ</span>
          </span>
          <span class="text-[10px] font-semibold tracking-wider text-slate-400 uppercase">
            Metal & Geri Dönüşüm
          </span>
        </div>
      </a>

      <!-- Desktop Nav Items -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Ana Menü">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3.5 py-2 rounded-lg text-sm font-semibold transition-all btn-nowrap ${
                link.highlight
                  ? 'text-orange-400 hover:text-white hover:bg-orange-500/20 border border-orange-500/30'
                  : isActive
                  ? 'text-amber-400 bg-white/10 font-bold'
                  : 'text-slate-200 hover:text-white hover:bg-white/5'
              }`}
            >
              {link.label}
              {link.highlight && (
                <span class="ml-1.5 px-1.5 py-0.5 text-[9px] font-bold uppercase rounded bg-orange-600 text-white">
                  Özel
                </span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Right Primary CTA -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4.5 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-bold shadow-md shadow-emerald-950/20 btn-nowrap hover:scale-[1.02] active:scale-[0.98] transition-all"
        >
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.34C9.36 7.34 9.09 7.4 8.87 7.65C8.64 7.89 8 8.49 8 9.72C8 10.95 8.89 12.14 9.01 12.31C9.14 12.47 10.77 14.97 13.25 16.05C13.84 16.31 14.3 16.46 14.66 16.58C15.26 16.77 15.8 16.74 16.24 16.68C16.73 16.61 17.74 16.07 17.95 15.48C18.16 14.89 18.16 14.38 18.1 14.28C18.04 14.18 17.88 14.12 17.64 14C17.4 13.88 16.21 13.3 15.99 13.22C15.77 13.14 15.61 13.1 15.45 13.34C15.29 13.59 14.83 14.12 14.69 14.28C14.55 14.44 14.41 14.47 14.17 14.35C13.93 14.23 12.92 13.89 11.72 12.82C10.79 11.99 10.16 10.96 10.04 10.76C9.92 10.56 10.03 10.45 10.15 10.33C10.26 10.22 10.4 10.04 10.52 9.9C10.64 9.76 10.68 9.66 10.76 9.5C10.84 9.34 10.8 9.2 10.74 9.08C10.68 8.96 10.22 7.83 10.03 7.37C9.84 6.92 9.65 6.98 9.53 7.34Z"/>
          </svg>
          <span>Fotoğraf At Fiyat Al</span>
        </a>
      </div>

      <!-- Mobile Hamburger Toggle -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden p-2 rounded-lg bg-slate-900 border border-white/20 text-white hover:text-amber-400 focus:outline-none"
        aria-label="Menüyü Aç / Kapat"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer / Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden bg-slate-950 border-t border-white/10 px-4 py-4 space-y-2">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-lg text-sm font-semibold transition-colors ${
            link.highlight
              ? 'text-orange-400 bg-orange-500/10 border border-orange-500/20 font-bold'
              : isActive
              ? 'text-amber-400 bg-white/10 font-bold'
              : 'text-slate-200 hover:bg-white/5'
          }`}
        >
          {link.label}
          {link.highlight && (
            <span class="ml-2 px-1.5 py-0.5 text-[10px] font-bold uppercase rounded bg-orange-600 text-white">
              Özel
            </span>
          )}
        </a>
      );
    })}

    <!-- Mobile Drawer WhatsApp Action -->
    <div class="pt-3">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 py-3 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-bold shadow-md"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.34C9.36 7.34 9.09 7.4 8.87 7.65C8.64 7.89 8 8.49 8 9.72C8 10.95 8.89 12.14 9.01 12.31C9.14 12.47 10.77 14.97 13.25 16.05C13.84 16.31 14.3 16.46 14.66 16.58C15.26 16.77 15.8 16.74 16.24 16.68C16.73 16.61 17.74 16.07 17.95 15.48C18.16 14.89 18.16 14.38 18.1 14.28C18.04 14.18 17.88 14.12 17.64 14C17.4 13.88 16.21 13.3 15.99 13.22C15.77 13.14 15.61 13.1 15.45 13.34C15.29 13.59 14.83 14.12 14.69 14.28C14.55 14.44 14.41 14.47 14.17 14.35C13.93 14.23 12.92 13.89 11.72 12.82C10.79 11.99 10.16 10.96 10.04 10.76C9.92 10.56 10.03 10.45 10.15 10.33C10.26 10.22 10.4 10.04 10.52 9.9C10.64 9.76 10.68 9.66 10.76 9.5C10.84 9.34 10.8 9.2 10.74 9.08C10.68 8.96 10.22 7.83 10.03 7.37C9.84 6.92 9.65 6.98 9.53 7.34Z"/>
        </svg>
        <span>WhatsApp ile Fotoğraf Gönder</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && menu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
