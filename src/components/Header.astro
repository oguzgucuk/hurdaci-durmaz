---
import company from '../data_files/company.json';

const currentPath = Astro.url.pathname;
const callUrl = `tel:${company.phoneRaw}`;
const waUrl = `https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(company.defaultWhatsAppMessage)}`;

const navLinks = [
  { href: '/', label: 'Ana Sayfa' },
  { href: '/hurda-fiyatlari', label: 'Fiyat Listesi' },
  { href: '/hurda-cesitleri', label: 'Hurda Çeşitleri' },
  { href: '/ikinci-el-klima-kombi', label: '2. El Klima & Kombi' },
  { href: '/bolgeler', label: 'Hizmet Bölgeleri' },
  { href: '/hizmetler', label: 'Hizmetlerimiz' },
  { href: '/iletisim', label: 'İletişim' },
];
---

<header class="sticky top-0 z-50 w-full shadow-sm relative">
  <!-- Top Mini Bar: Forest Green with Phone & Service Info (Hidden on Mobile) -->
  <div class="hidden sm:block bg-[#0e3b2e] text-white py-1.5 px-4 sm:px-8 xl:px-12 text-xs border-b border-emerald-950/40">
    <div class="w-full flex items-center justify-between gap-4">
      <!-- Left: Phone & Address Service -->
      <div class="flex items-center gap-4 sm:gap-6 font-medium text-slate-100">
        <a href={callUrl} class="flex items-center gap-1.5 hover:text-amber-400 transition-colors">
          <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="font-bold tracking-wide">{company.phone}</span>
        </a>

        <span class="hidden md:flex items-center gap-1.5 text-slate-200">
          <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Adresten Hassas Kantarla Hurda Alımı</span>
        </span>
      </div>

      <!-- Right: Hours & WhatsApp Quick Access -->
      <div class="flex items-center gap-4 text-slate-200 text-xs ml-auto">
        <span class="hidden sm:inline text-slate-300">
          İstanbul & Gebze Geneli 7/24
        </span>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1 text-emerald-300 hover:text-emerald-200 font-bold transition-colors"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>WhatsApp Teklif</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation: Full width with comfortable edge padding -->
  <nav class="bg-white border-b border-slate-200/90 text-slate-800" aria-label="Ana Gezinti">
    <div class="w-full px-4 sm:px-8 xl:px-12">
      <div class="flex items-center justify-between h-20 gap-4">
        
        <!-- Brand Logo (Far Left) -->
        <a href="/" class="flex items-center gap-3 group focus:outline-none shrink-0" aria-label="Hurdacı Durmaz Metal Ana Sayfa">
          <div class="w-11 h-11 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center shrink-0 group-hover:bg-emerald-100 transition-colors shadow-xs">
            <svg class="w-7 h-7 text-[#0e3b2e]" viewBox="0 0 48 48" fill="none" aria-hidden="true">
              <!-- Universal Eco Recycling Arrows in Triangle -->
              <path d="M24 6L28 13H20L24 6Z" fill="#0e3b2e"/>
              <path d="M12 28L8 21L15 21L12 28Z" fill="#135d46"/>
              <path d="M36 28L40 21L33 21L36 28Z" fill="#ea580c"/>
              <path d="M24 16C18 16 13 21 13 27C13 33 18 38 24 38C29 38 33 34.5 34.5 30" stroke="#0e3b2e" stroke-width="3.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 leading-tight font-display">
              DURMAZ <span class="text-[#0e3b2e]">METAL</span>
            </span>
            <span class="text-[10px] font-bold tracking-wider text-slate-500 uppercase">
              Hurdacılık & Geri Dönüşüm
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links (Spacious in Center) -->
        <div class="hidden lg:flex items-center justify-center gap-1 xl:gap-3 flex-1 mx-4">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <a
                href={link.href}
                class={`px-3 py-2 rounded-lg text-sm font-semibold transition-all whitespace-nowrap ${
                  isActive
                    ? 'text-[#0e3b2e] bg-emerald-50 font-bold border-b-2 border-[#0e3b2e]'
                    : 'text-slate-700 hover:text-[#0e3b2e] hover:bg-slate-50'
                }`}
              >
                {link.label}
              </a>
            );
          })}
        </div>

        <!-- Right Action Button: Bold Orange "Hemen Ara" (Far Right) -->
        <div class="hidden sm:flex items-center gap-3 shrink-0">
          <a
            href={callUrl}
            class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#ea580c] hover:bg-[#c2410c] text-white text-sm font-extrabold shadow-md hover:scale-102 transition-all"
            aria-label="Hemen Ara"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
            </svg>
            <span>Hemen Ara</span>
          </a>
        </div>

        <!-- Mobile Menu Hamburger Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="lg:hidden p-2 rounded-lg bg-slate-100 text-slate-800 hover:text-[#0e3b2e] hover:bg-slate-200 focus:outline-none"
          aria-label="Menüyü Aç / Kapat"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

      </div>
    </div>
  </nav>

  <!-- Mobile Overlay Backdrop (Opens over content) -->
  <div id="mobile-menu-backdrop" class="hidden fixed inset-0 top-20 bg-slate-950/50 backdrop-blur-xs z-40 transition-opacity"></div>

  <!-- Mobile Drawer Menu (Opens ON TOP of page content as an absolute dropdown) -->
  <div id="mobile-menu" class="hidden lg:hidden absolute top-full left-0 right-0 z-50 bg-white border-b border-slate-200 px-4 py-4 space-y-2 shadow-2xl max-h-[80vh] overflow-y-auto">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-lg text-sm font-semibold transition-colors ${
            isActive
              ? 'text-[#0e3b2e] bg-emerald-50 font-bold'
              : 'text-slate-800 hover:bg-slate-100'
          }`}
        >
          {link.label}
        </a>
      );
    })}

    <!-- Mobile Drawer Call Action -->
    <div class="pt-3 border-t border-slate-100 flex flex-col gap-2">
      <a
        href={callUrl}
        class="w-full flex items-center justify-center gap-2 py-3 rounded-lg bg-[#ea580c] hover:bg-[#c2410c] text-white text-sm font-extrabold shadow-sm"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
        </svg>
        <span>Hemen Ara: {company.phone}</span>
      </a>

      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 py-3 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-extrabold shadow-sm"
      >
        <span>WhatsApp ile Fotoğraf Gönder</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function toggleMenu() {
    if (!toggleBtn || !menu || !iconOpen || !iconClose) return;
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
    menu.classList.toggle('hidden');
    backdrop?.classList.toggle('hidden');
    iconOpen.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');
  }

  toggleBtn?.addEventListener('click', toggleMenu);
  backdrop?.addEventListener('click', toggleMenu);

  // Close menu when tapping any link inside
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (menu && !menu.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });
</script>
