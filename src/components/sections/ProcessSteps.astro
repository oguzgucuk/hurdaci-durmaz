---
import company from '../../data_files/company.json';

const steps = [
  {
    number: '01',
    title: 'Fotoğraf Gönderin',
    desc: 'Elinizdeki hurda metallerin, kabloların veya 2. el klima/kombinizin net fotoğrafını WhatsApp numaramıza iletin.',
    badge: '5 Dk’da Yanıt',
    actionText: 'WhatsApp ile Gönder',
    actionUrl: `https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(company.defaultWhatsAppMessage)}`,
  },
  {
    number: '02',
    title: 'Fiyatı Onaylayın, Gelelim',
    desc: 'Borsa kurlarına göre en iyi fiyatı sunalım. Anlaştığımız an mobil aracımız ve taşıma ekibimiz adresinize yola çıksın.',
    badge: '1 Saatte Kapıda',
    actionText: 'Hemen Bilgi Al',
    actionUrl: `tel:${company.phoneRaw}`,
  },
  {
    number: '03',
    title: 'Hassas Tartım & Nakit Ödeme',
    desc: 'Elektronik kalibre dijital baskülle gözünüzün önünde tartım yapalım. Net kantar fişinizi verip paranızı anında elden peşin ödeyelim.',
    badge: 'Kapıda Peşin Nakit',
    actionText: 'Hemen İletişime Geç',
    actionUrl: `tel:${company.phoneRaw}`,
  },
];
---

<section class="py-16 sm:py-24 bg-white border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-2xl mx-auto space-y-3 pb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 border border-amber-200 text-xs font-bold tracking-wide">
        <span>KOLAY SATIŞ SÜRECİ</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 font-display tracking-tight">
        3 Kolay Adımda <span class="text-amber-600">Hurdanızı Nakite</span> Çevirin
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        Taşıma zahmeti yok, günlerce tahsilat bekleme yok. Adresinizde tartım, kapınızda anında peşin ödeme.
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {steps.map((step) => (
        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-200/80 flex flex-col justify-between hover:bg-white hover:border-amber-400 hover:shadow-md transition-all group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-display text-4xl font-extrabold text-amber-500 tabular-nums">
                {step.number}
              </span>
              <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-700 shadow-2xs">
                {step.badge}
              </span>
            </div>

            <h3 class="text-xl font-bold text-slate-900 font-display">
              {step.title}
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {step.desc}
            </p>
          </div>

          <!-- Action trigger -->
          <div class="pt-6 mt-6 border-t border-slate-200/70">
            <a
              href={step.actionUrl}
              class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-800 hover:text-amber-600 transition-colors"
            >
              <span>{step.actionText}</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
