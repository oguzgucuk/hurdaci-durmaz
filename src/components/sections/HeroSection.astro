---
import company from '../../data_files/company.json';

const callUrl = `tel:${company.phoneRaw}`;
const waUrl = `https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(company.defaultWhatsAppMessage)}`;
---

<section class="relative bg-slate-50 pt-6 sm:pt-8 pb-16 lg:pb-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    
    <!-- Hero Main Split Container: Deep Forest Green Card + Real Worker Photo -->
    <div class="relative rounded-3xl bg-[#0e3b2e] overflow-hidden shadow-xl border border-emerald-950/20">
      
      <!-- Subtle Pattern / Gradient in Forest Green Card -->
      <div class="absolute inset-0 bg-radial from-emerald-900/30 to-transparent pointer-events-none" aria-hidden="true"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch min-h-[520px]">
        
        <!-- Left Column: Copy & Actions (7 Cols on desktop) -->
        <div class="lg:col-span-7 p-6 sm:p-10 lg:p-14 flex flex-col justify-center relative z-10">
          
          <!-- Small Brand / Trust Tag -->
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="px-3 py-1 rounded-full bg-white/10 text-amber-400 text-xs sm:text-sm font-bold tracking-wide uppercase border border-white/10">
              Hurdacı Durmaz Metal · İstanbul & Gebze
            </span>
          </div>

          <!-- Bold, Authentic Turkish Scrap Headline -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[2.75rem] xl:text-[3.25rem] font-extrabold tracking-tight text-white leading-[1.15] mb-5 font-display">
            Metaliniz Değerinde, <br class="hidden sm:inline" />
            <span class="text-amber-400">Geleceğiniz Güvence</span> Altında.
          </h1>

          <!-- High-Trust Human Subtitle -->
          <p class="text-slate-200 text-sm sm:text-base lg:text-lg leading-relaxed mb-8 max-w-xl">
            Bakır, kablo, alüminyum, demir hurdalarınızı ve <strong>2. el klima/kombilerinizi</strong> serbest piyasanın en yüksek fiyatından nakit alıyor, dijital hassas kantarla adresinizde tartıyoruz.
          </p>

          <!-- Action Buttons (Matches screenshot orange "Hemen Ara" + white "Fiyat Listesi") -->
          <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-6">
            <a
              href={callUrl}
              class="inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3.5 rounded-xl bg-[#ea580c] hover:bg-[#c2410c] text-white font-extrabold text-sm sm:text-base shadow-lg transition-transform hover:scale-102 active:scale-98"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
              </svg>
              <span>Hemen Ara</span>
            </a>

            <a
              href="/hurda-fiyatlari"
              class="inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3.5 rounded-xl bg-white hover:bg-slate-100 text-[#0e3b2e] font-extrabold text-sm sm:text-base shadow transition-colors"
            >
              <span>Fiyat Listesi</span>
              <svg class="w-4 h-4 text-emerald-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow transition-colors"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.34C9.36 7.34 9.09 7.4 8.87 7.65C8.64 7.89 8 8.49 8 9.72C8 10.95 8.89 12.14 9.01 12.31C9.14 12.47 10.77 14.97 13.25 16.05C13.84 16.31 14.3 16.46 14.66 16.58C15.26 16.77 15.8 16.74 16.24 16.68C16.73 16.61 17.74 16.07 17.95 15.48C18.16 14.89 18.16 14.38 18.1 14.28C18.04 14.18 17.88 14.12 17.64 14C17.4 13.88 16.21 13.3 15.99 13.22C15.77 13.14 15.61 13.1 15.45 13.34C15.29 13.59 14.83 14.12 14.69 14.28C14.55 14.44 14.41 14.47 14.17 14.35C13.93 14.23 12.92 13.89 11.72 12.82C10.79 11.99 10.16 10.96 10.04 10.76C9.92 10.56 10.03 10.45 10.15 10.33C10.26 10.22 10.4 10.04 10.52 9.9C10.64 9.76 10.68 9.66 10.76 9.5C10.84 9.34 10.8 9.2 10.74 9.08C10.68 8.96 10.22 7.83 10.03 7.37C9.84 6.92 9.65 6.98 9.53 7.34Z"/>
              </svg>
              <span>WhatsApp Teklif</span>
            </a>
          </div>

          <!-- Micro proof line -->
          <div class="flex items-center gap-4 text-xs sm:text-sm text-emerald-200">
            <span class="flex items-center gap-1.5 font-medium">
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              Kapıda Nakit Ödeme
            </span>
            <span class="flex items-center gap-1.5 font-medium">
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              Hassas Kalibre Kantar
            </span>
          </div>

        </div>

        <!-- Right Column: Real Worker Photo with Arch / Shape (5 Cols on desktop) -->
        <div class="lg:col-span-5 relative flex items-center justify-center p-4 sm:p-6 lg:p-8">
          
          <!-- Image Container with soft arch border (like the screenshot) -->
          <div class="relative w-full h-[320px] sm:h-[400px] lg:h-full max-h-[500px] rounded-2xl lg:rounded-3xl overflow-hidden shadow-2xl border-2 border-emerald-500/30">
            <img
              src="/images/hero/hero-worker-recycling.jpg"
              alt="Hurdacı Durmaz Metal Uzman Geri Dönüşüm Ekibi ve Hurda Tesisi"
              class="w-full h-full object-cover object-center"
              loading="eager"
              fetchpriority="high"
            />

            <!-- Eco Badge Overlay in the corner -->
            <div class="absolute top-4 right-4 bg-emerald-600/90 text-white p-2.5 rounded-2xl backdrop-blur-md shadow-lg border border-white/20">
              <svg class="w-8 h-8 fill-current text-emerald-100" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
              </svg>
            </div>

            <!-- Fast Call Out Floating Pill (Hidden on Mobile) -->
            <div class="hidden sm:flex absolute bottom-4 left-4 right-4 bg-slate-950/85 backdrop-blur-md text-white p-3.5 rounded-xl border border-white/15 items-center justify-between shadow-xl gap-2">
              <div>
                <span class="text-[10px] text-amber-400 font-bold uppercase tracking-wider block">Anında Fiyat Teklifi</span>
                <span class="text-xs sm:text-sm font-bold text-white">Fotoğraf Atın, 5 Dakikada Değerini Öğrenin</span>
              </div>
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs flex items-center gap-1.5 shrink-0 transition-transform active:scale-95 shadow-sm"
                aria-label="WhatsApp ile Fiyat Al"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.34C9.36 7.34 9.09 7.4 8.87 7.65C8.64 7.89 8 8.49 8 9.72C8 10.95 8.89 12.14 9.01 12.31C9.14 12.47 10.77 14.97 13.25 16.05C13.84 16.31 14.3 16.46 14.66 16.58C15.26 16.77 15.8 16.74 16.24 16.68C16.73 16.61 17.74 16.07 17.95 15.48C18.16 14.89 18.16 14.38 18.1 14.28C18.04 14.18 17.88 14.12 17.64 14C17.4 13.88 16.21 13.3 15.99 13.22C15.77 13.14 15.61 13.1 15.45 13.34C15.29 13.59 14.83 14.12 14.69 14.28C14.55 14.44 14.41 14.47 14.17 14.35C13.93 14.23 12.92 13.89 11.72 12.82C10.79 11.99 10.16 10.96 10.04 10.76C9.92 10.56 10.03 10.45 10.15 10.33C10.26 10.22 10.4 10.04 10.52 9.9C10.64 9.76 10.68 9.66 10.76 9.5C10.84 9.34 10.8 9.2 10.74 9.08C10.68 8.96 10.22 7.83 10.03 7.37C9.84 6.92 9.65 6.98 9.53 7.34Z"/>
                </svg>
                <span>Fiyat Al</span>
              </a>
            </div>

          </div>

        </div>

      </div>

    </div>

    <!-- 3 Bottom Highlight Cards (Directly matching the screenshot's Green, Orange & Forest cards!) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 mt-6">
      
      <!-- Card 1: Green Card -->
      <div class="rounded-2xl bg-[#135d46] text-white p-6 sm:p-7 shadow-md flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-emerald-200 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h2 class="text-xl font-extrabold text-white mb-2">Her Türlü Metal Hurda Alımı</h2>
          <p class="text-slate-200 text-xs sm:text-sm leading-relaxed">
            Demir, bakır, alüminyum, sarı pirinç ve hurda kablolarınızı Londra Metal Borsası (LME) tavan kurlarından yerinde alıyoruz.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-white/10">
          <a href="/hurda-cesitleri" class="text-xs font-bold text-amber-300 hover:text-white flex items-center gap-1 transition-colors">
            Tüm Hurda Çeşitleri →
          </a>
        </div>
      </div>

      <!-- Card 2: Orange Card -->
      <div class="rounded-2xl bg-[#ea580c] text-white p-6 sm:p-7 shadow-md flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center text-white mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h2 class="text-xl font-extrabold text-white mb-2">Hurda Karşılığı Peşin Ödeme</h2>
          <p class="text-orange-50 text-xs sm:text-sm leading-relaxed">
            Hurdalarınızı kapınızda elektronik kalibre teraziyle tartıyor; tartım bittiği an elden nakit veya anında IBAN transferi yapıyoruz.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-white/20">
          <a href={callUrl} class="text-xs font-bold text-white hover:text-orange-100 flex items-center gap-1 transition-colors">
            Hemen Fiyat Sor: {company.phone} →
          </a>
        </div>
      </div>

      <!-- Card 3: Deep Forest Green Card (2. El Klima & Kombi Focused) -->
      <div class="rounded-2xl bg-[#0e3b2e] text-white p-6 sm:p-7 shadow-md flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-amber-300 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="text-xl font-extrabold text-white mb-2">2. El Klima & Kombi Alımı</h2>
          <p class="text-slate-200 text-xs sm:text-sm leading-relaxed">
            Duvardan söküm zahmetine katlanmayın! Çalışır veya arızalı klimalarınızı ustalarımızla söküp değerinde peşin nakit alıyoruz.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-white/10">
          <a href="/ikinci-el-klima-kombi" class="text-xs font-bold text-amber-300 hover:text-white flex items-center gap-1 transition-colors">
            Klima Alım Detayları & Söküm →
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
