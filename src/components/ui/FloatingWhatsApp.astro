---
import company from '../../data_files/company.json';

interface Props {
  customMessage?: string;
}

const { customMessage } = Astro.props;
const message = customMessage || company.defaultWhatsAppMessage;
const encodedMessage = encodeURIComponent(message);
const waUrl = `https://wa.me/${company.whatsappRaw}?text=${encodedMessage}`;
---

<!-- Fixed Floating WhatsApp Button (z-40 so it stays above content, elevated on mobile) -->
<aside class="fixed bottom-6 right-4 sm:right-6 z-40 flex items-center gap-3 group" aria-label="Hızlı WhatsApp İletişim Hattı">
  <!-- Pulsing Helper Tooltip -->
  <div class="hidden sm:flex items-center gap-2 bg-white/95 border border-slate-200 px-3.5 py-2 rounded-xl shadow-lg text-xs text-slate-800 backdrop-blur-md transition-all duration-200 group-hover:scale-105">
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
    </span>
    <span class="font-medium whitespace-nowrap">Fotoğraf atın, <strong class="text-amber-600 font-bold">5 dk'da</strong> fiyat verelim</span>
  </div>

  <!-- WhatsApp Action Trigger -->
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="WhatsApp'tan Hurda Fotoğrafı Gönderip Fiyat Alın"
    class="relative flex items-center justify-center w-14 h-14 rounded-full bg-[var(--color-whatsapp)] text-[var(--color-whatsapp-ink)] shadow-2xl hover:bg-[var(--color-whatsapp-hover)] hover:scale-105 active:scale-95 transition-all duration-150 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-whatsapp)]"
  >
    <!-- Ripple Halo -->
    <span class="absolute inset-0 rounded-full bg-[var(--color-whatsapp)] animate-ping opacity-25 pointer-events-none"></span>

    <!-- WhatsApp SVG Icon -->
    <svg class="w-8 h-8 fill-current relative z-10" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.34C9.36 7.34 9.09 7.4 8.87 7.65C8.64 7.89 8 8.49 8 9.72C8 10.95 8.89 12.14 9.01 12.31C9.14 12.47 10.77 14.97 13.25 16.05C13.84 16.31 14.3 16.46 14.66 16.58C15.26 16.77 15.8 16.74 16.24 16.68C16.73 16.61 17.74 16.07 17.95 15.48C18.16 14.89 18.16 14.38 18.1 14.28C18.04 14.18 17.88 14.12 17.64 14C17.4 13.88 16.21 13.3 15.99 13.22C15.77 13.14 15.61 13.1 15.45 13.34C15.29 13.59 14.83 14.12 14.69 14.28C14.55 14.44 14.41 14.47 14.17 14.35C13.93 14.23 12.92 13.89 11.72 12.82C10.79 11.99 10.16 10.96 10.04 10.76C9.92 10.56 10.03 10.45 10.15 10.33C10.26 10.22 10.4 10.04 10.52 9.9C10.64 9.76 10.68 9.66 10.76 9.5C10.84 9.34 10.8 9.2 10.74 9.08C10.68 8.96 10.22 7.83 10.03 7.37C9.84 6.92 9.65 6.98 9.53 7.34Z"/>
    </svg>
  </a>
</aside>
