---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';
import company from '../../data_files/company.json';

export async function getStaticPaths() {
  const metals = await getCollection('metals');
  return metals.map((metal) => ({
    params: { slug: metal.id },
    props: { metal },
  }));
}

const { metal } = Astro.props;
const { Content } = await render(metal);

const callUrl = `tel:${company.phoneRaw}`;
const waUrl = `https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(`Merhaba Durmaz Metal, ${metal.data.title} satmak istiyorum. Güncel fiyat ve adresten alım için bilgi alabilir miyim?`)}`;

const pageTitle = `${metal.data.title} Fiyatları & Alımı | Durmaz Metal`;
const pageDesc = `${metal.data.title} için en güncel borsa fiyatı üzerinden yerinde dijital kantar tartımı ve anında nakit ödeme. İstanbul geneli adresten hurda alımı.`;
---

<MainLayout title={pageTitle} description={pageDesc}>
  <!-- Top Breadcrumb & Heading -->
  <section class="bg-gradient-to-b from-[#0e3b2e] to-[#134939] text-white py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-300 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Ana Sayfa</a>
        <span>/</span>
        <a href="/hurda-cesitleri" class="hover:text-white">Hurda Çeşitleri</a>
        <span>/</span>
        <span class="text-amber-400 font-semibold">{metal.data.title}</span>
      </nav>

      <div class="max-w-4xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-emerald-300 text-xs sm:text-sm font-semibold border border-white/15">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>GÜNCEL BORSA FİYATLARIYLA NAKİT ALIM</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">
          {metal.data.title}
        </h1>
        <p class="text-base sm:text-lg text-slate-200 leading-relaxed">
          {metal.data.shortDesc}
        </p>
      </div>
    </div>
  </section>

  <!-- Content & Sidebar -->
  <section class="py-16 bg-[var(--color-paper)] border-b border-[var(--color-rule)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: Prose Markdown Body -->
        <article class="lg:col-span-8 space-y-8 prose prose-invert max-w-none text-[var(--color-ink-muted)]">
          <div class="p-6 rounded-xl bg-[var(--color-paper-2)] border border-[var(--color-rule)]">
            <h2 class="text-lg font-bold text-[var(--color-ink)] font-display uppercase tracking-tight mb-3">
              Alımını Yaptığımız Alt Çeşitler
            </h2>
            <div class="flex flex-wrap gap-2">
              {metal.data.subTypes.map((sub) => (
                <span class="px-3 py-1 rounded-md bg-[var(--color-paper-3)] border border-[var(--color-rule-subtle)] text-xs font-semibold text-[var(--color-ink)]">
                  {sub}
                </span>
              ))}
            </div>
          </div>

          <!-- Rendered Markdown Body -->
          <div class="content-body space-y-6 text-sm sm:text-base leading-relaxed">
            <Content />
          </div>

          <!-- Direct CTA Inside Article -->
          <div class="p-8 rounded-xl bg-[var(--color-paper-2)] border-2 border-[var(--color-accent)]/30 space-y-4 not-prose">
            <h3 class="text-xl font-bold text-[var(--color-ink)] uppercase font-display">
              {metal.data.title} İçin Şimdi Fiyat Alın
            </h3>
            <p class="text-xs sm:text-sm text-[var(--color-ink-muted)]">
              Malzemenizin miktarını ve fotoğrafını WhatsApp'tan iletin, ustanız 5 dakika içinde anlık borsa fiyatıyla teklifinizi versin.
            </p>
            <div class="flex flex-wrap gap-3 pt-2">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-6 py-3 rounded-lg btn-whatsapp font-bold text-sm flex items-center gap-2 shadow-lg"
              >
                <span>WhatsApp'tan Fotoğraf At</span>
              </a>
              <a
                href={callUrl}
                class="px-6 py-3 rounded-lg btn-amber font-bold text-sm flex items-center gap-2 shadow-lg"
              >
                <span>Telefon Et: {company.phone}</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Right: Sticky Verification & Fast Contact Widget -->
        <aside class="lg:col-span-4 space-y-6">
          <div class="sticky top-6 space-y-6">
            <div class="rounded-xl bg-[var(--color-paper-2)] border border-[var(--color-rule)] p-6 space-y-4">
              <h3 class="text-sm font-mono font-bold uppercase text-[var(--color-accent)] tracking-wider border-b border-[var(--color-rule-subtle)] pb-2">
                Hızlı Fiyat & Adrese Servis
              </h3>

              <div class="space-y-3 text-xs text-[var(--color-ink-muted)]">
                <div class="flex items-center gap-2">
                  <span class="text-[var(--color-accent)] font-bold">✓</span>
                  <span>Elektronik dijital teraziyle tartım</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-[var(--color-accent)] font-bold">✓</span>
                  <span>Tartım anında peşin nakit ödeme</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-[var(--color-accent)] font-bold">✓</span>
                  <span>1 saatte İstanbul & Gebze geneli alım</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-[var(--color-accent)] font-bold">✓</span>
                  <span>Hamaliye ve nakliye tarafımızca karşılanır</span>
                </div>
              </div>

              <div class="pt-4 border-t border-[var(--color-rule-subtle)] space-y-2.5">
                <a
                  href={waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full flex items-center justify-center gap-2 py-3 rounded-lg btn-whatsapp font-bold text-xs"
                >
                  WhatsApp Fiyat Al
                </a>
                <a
                  href={callUrl}
                  class="w-full flex items-center justify-center gap-2 py-3 rounded-lg btn-outline font-bold text-xs"
                >
                  Hemen Ara: {company.phone}
                </a>
              </div>
            </div>

            <div class="p-6 rounded-xl bg-[var(--color-paper-3)] border border-[var(--color-rule)] space-y-2">
              <div class="text-xs font-mono text-[var(--color-copper)] font-bold uppercase">2. El Cihazınız mı Var?</div>
              <p class="text-xs text-[var(--color-ink-muted)]">
                Klima ve kombilerinizi de adresinizden değerinde nakit alıyoruz.
              </p>
              <a href="/ikinci-el-klima-kombi" class="text-xs font-bold text-[var(--color-copper)] hover:underline inline-block pt-1">
                Klima & Kombi Alımı →
              </a>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </section>
</MainLayout>
