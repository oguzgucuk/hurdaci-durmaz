---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import company from '../../data_files/company.json';

const services = await getCollection('services');
services.sort((a, b) => a.data.order - b.data.order);

const title = "Hizmetlerimiz — Adresten Hurda Alımı, Yıkım & Söküm | Durmaz Metal";
const description = "Hurdacı Durmaz Metal kurumsal hizmetleri: Adresten hurda alımı, 2. el klima/kombi alımı, kentsel dönüşüm bina yıkımı ve fabrika tesis söküm işleri.";
---

<MainLayout title={title} description={description}>
  <!-- Header -->
  <section class="py-16 sm:py-20 bg-slate-50 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 border border-amber-200 text-xs font-bold tracking-wide">
          <span>KURUMSAL GERİ DÖNÜŞÜM & TAAHHÜT HİZMETLERİ</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 font-display tracking-tight">
          Hizmetlerimiz
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Bireysel ev sahiplerinden sanayi tesislerine, şantiyelerden kentsel dönüşüm müteahhitlerine kadar her ölçekte profesyonel ekipman ve nakit sermaye ile hizmet veriyoruz.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-16 sm:py-24 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {services.map((service) => {
          const waUrl = `https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(`Merhaba Durmaz Metal, ${service.data.title} hizmetinizle ilgili keşif ve teklif almak istiyorum.`)}`;
          return (
            <div class="p-8 rounded-2xl bg-slate-50 border border-slate-200/80 flex flex-col justify-between hover:bg-white hover:border-amber-400 hover:shadow-md transition-all group">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-800 shadow-2xs">
                    {service.data.featured ? 'Öne Çıkan' : 'Kurumsal'}
                  </span>
                  <span class="text-xs font-medium text-slate-500">
                    İstanbul & Gebze
                  </span>
                </div>

                <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-display group-hover:text-amber-600 transition-colors">
                  <a href={`/hizmetler/${service.id}`}>{service.data.title}</a>
                </h2>

                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  {service.data.description}
                </p>

                <div class="space-y-2 pt-2">
                  <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide">Avantajlar:</div>
                  <ul class="space-y-1.5 text-xs text-slate-700 font-medium">
                    {service.data.benefits.map((b) => (
                      <li class="flex items-center gap-2">
                        <span class="text-amber-600 font-bold">✓</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Footer CTA -->
              <div class="pt-6 mt-6 border-t border-slate-200/70 flex items-center justify-between">
                <a
                  href={waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-bold text-emerald-700 hover:text-emerald-800 inline-flex items-center gap-1.5"
                >
                  <span>WhatsApp'tan Danış</span>
                  <span>→</span>
                </a>

                <a
                  href={`/hizmetler/${service.id}`}
                  class="text-xs font-semibold text-slate-700 underline hover:text-amber-600 transition-colors"
                >
                  Hizmet Detayı
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</MainLayout>
