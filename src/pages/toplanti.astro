  <!-- JAVASCRIPT: AUTOSAVE & ACTIONS -->
  <script is:inline>
    const STORAGE_KEY = 'durmaz_metal_meeting_data_v1';

    const fieldIds = [
      'q_adrese_gitme', 'n_adrese_gitme',
      'q_kantar_tipi', 'n_kantar_tipi',
      'q_arac_filosu', 'n_arac_filosu',
      'q_sokum_ekibi', 'n_sokum_ekibi',
      'q_goruntulu_fiyat', 'n_goruntulu_fiyat',
      'q_calisma_saatleri', 'n_calisma_saatleri',
      'q_telefon_hatlari', 'n_telefon_hatlari',
      'q_dukkan_foto', 'n_dukkan_foto',
      'q_kamyon_foto', 'n_kamyon_foto',
      'q_kisa_video', 'n_kisa_video',
      'q_gecmis_referans', 'n_gecmis_referans',
      'q_odeme_sekli', 'n_odeme_sekli',
      'q_klima_ikinci_el', 'n_klima_ikinci_el',
      'q_fatura_gider_pusulasi', 'n_fatura_gider_pusulasi',
      'q_alinmayan_hurda', 'n_alinmayan_hurda',
      'meeting_custom_notes', 'meeting_outcome_notes'
    ];

    const saveIndicator = document.getElementById('saveIndicator');

    function flashSave() {
      if (!saveIndicator) return;
      saveIndicator.style.opacity = '1';
      setTimeout(() => {
        saveIndicator.style.opacity = '0';
      }, 1500);
    }

    function saveData() {
      const data = {};
      fieldIds.forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        if (el.type === 'checkbox') {
          data[id] = el.checked;
        } else {
          data[id] = el.value;
        }
      });
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      flashSave();
    }

    function loadData() {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      try {
        const data = JSON.parse(raw);
        fieldIds.forEach(id => {
          const el = document.getElementById(id);
          if (!el || data[id] === undefined) return;
          if (el.type === 'checkbox') {
            el.checked = Boolean(data[id]);
          } else {
            el.value = data[id];
          }
        });
      } catch (err) {
        console.error('Veri yüklenirken hata:', err);
      }
    }

    fieldIds.forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      el.addEventListener('input', saveData);
      el.addEventListener('change', saveData);
    });

    document.getElementById('copyBtn')?.addEventListener('click', () => {
      const notes = document.getElementById('meeting_custom_notes')?.value || '';
      const outcome = document.getElementById('meeting_outcome_notes')?.value || '';

      let text = `=========================================\n`;
      text += `HURDACI DURMAZ METAL - TOPLANTI BRİFİNGİ\n`;
      text += `Tarih: ${new Date().toLocaleDateString('tr-TR')} ${new Date().toLocaleTimeString('tr-TR')}\n`;
      text += `=========================================\n\n`;

      text += `--- ALINAN KARAR & ANLAŞMA ---\n${outcome || 'Belirtilmedi'}\n\n`;
      text += `--- MÜŞTERİNİN ÖZEL İSTEKLERİ ---\n${notes || 'Belirtilmedi'}\n\n`;

      text += `--- SAHA VE OPERASYON BİLGİLERİ ---\n`;
      fieldIds.forEach(id => {
        if (id.startsWith('n_')) {
          const val = document.getElementById(id)?.value;
          if (val) {
            const label = id.replace('n_', '').replaceAll('_', ' ');
            text += `• ${label.toUpperCase()}: ${val}\n`;
          }
        }
      });

      navigator.clipboard.writeText(text).then(() => {
        alert('Tüm toplantı notları panoya kopyalandı! İstediğin yere yapıştırabilirsin.');
      });
    });

    document.getElementById('downloadBtn')?.addEventListener('click', () => {
      const notes = document.getElementById('meeting_custom_notes')?.value || '';
      const outcome = document.getElementById('meeting_outcome_notes')?.value || '';

      let text = `HURDACI DURMAZ METAL - TOPLANTI NOTLARI\n`;
      text += `Tarih: ${new Date().toLocaleDateString('tr-TR')}\n\n`;
      text += `KARAR:\n${outcome}\n\nİSTEKLER:\n${notes}\n\n`;

      fieldIds.forEach(id => {
        if (id.startsWith('n_')) {
          const val = document.getElementById(id)?.value;
          if (val) {
            text += `${id}: ${val}\n`;
          }
        }
      });

      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `durmaz-metal-toplanti-notlari-${new Date().toISOString().slice(0, 10)}.txt`;
      a.click();
    });

    document.getElementById('resetBtn')?.addEventListener('click', () => {
      if (confirm('Tüm notları temizlemek istediğinize emin misiniz?')) {
        localStorage.removeItem(STORAGE_KEY);
        fieldIds.forEach(id => {
          const el = document.getElementById(id);
          if (!el) return;
          if (el.type === 'checkbox') el.checked = false;
          else el.value = '';
        });
        alert('Tüm form temizlendi.');
      }
    });

    loadData();
  </script>

</body>
</html>
