---
// src/pages/toplanti.astro - Hurdacı Durmaz Metal Toplantı & Müşteri Brifing Portalı
import '../assets/styles/global.css';
---

<!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Hurdacı Durmaz Metal — Toplantı & Müşteri Brifing Portalı</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
  
  <style is:inline>
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: #f8fafc !important;
      color: #0f172a !important;
      margin: 0;
      padding: 0;
    }
    h1, h2, h3, h4, .font-display {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    svg {
      display: inline-block;
      vertical-align: middle;
      flex-shrink: 0;
    }
    svg.icon-sm, .icon-sm {
      width: 16px !important;
      height: 16px !important;
      min-width: 16px !important;
      max-width: 16px !important;
      min-height: 16px !important;
      max-height: 16px !important;
    }
    .check-bullet {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 9999px;
      background-color: #ecfdf5;
      color: #059669;
      border: 1px solid #a7f3d0;
      font-size: 11px;
      font-weight: 900;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .cross-bullet {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 9999px;
      background-color: #f1f5f9;
      color: #94a3b8;
      border: 1px solid #cbd5e1;
      font-size: 11px;
      font-weight: bold;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .star-bullet {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 9999px;
      background-color: #fef3c7;
      color: #d97706;
      border: 1px solid #fde68a;
      font-size: 11px;
      font-weight: 900;
      flex-shrink: 0;
      margin-top: 1px;
    }
    @media print {
      .no-print {
        display: none !important;
      }
      body {
        background: white !important;
        color: black !important;
      }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen selection:bg-amber-400 selection:text-slate-950">

  <!-- TOP BAR & STATUS -->
  <header class="border-b border-slate-200 bg-white/95 backdrop-blur sticky top-0 z-50 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-4">
      
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center font-black text-white text-xl shadow-md shadow-amber-500/20 shrink-0">
          D
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-base font-extrabold text-slate-900 tracking-tight">HURDACI DURMAZ METAL</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-100 text-emerald-800 border border-emerald-200">
              Toplantı & Brifing Portalı
            </span>
          </div>
          <p class="text-xs text-slate-500 font-medium">Strateji, Fiyat Teklifi & Saha Bilgi Entegrasyon Dosyası</p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2.5 no-print">
        <span id="saveIndicator" class="text-xs text-emerald-700 flex items-center gap-1.5 opacity-0 transition-opacity duration-300 font-semibold bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Otomatik Kaydedildi
        </span>

        <button 
          id="copyBtn" 
          class="px-3.5 py-2 rounded-lg bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-300 transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs"
          title="Tüm notları metin olarak panoya kopyala"
        >
          <svg class="icon-sm text-amber-600" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>
          <span>Notları Kopyala</span>
        </button>

        <button 
          id="downloadBtn" 
          class="px-3.5 py-2 rounded-lg bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-300 transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs"
          title="Notları metin dosyası olarak bilgisayara indir"
        >
          <svg class="icon-sm text-emerald-600" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
          <span>Metin İndir</span>
        </button>

        <button 
          onclick="window.print()" 
          class="px-3.5 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm shadow-amber-500/20 cursor-pointer"
        >
          <svg class="icon-sm" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
          <span>Yazdır / PDF</span>
        </button>
      </div>

    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">

    <!-- 🎯 SANA ÖZEL: TOPLANTI KONUŞMA SIRALAMASI & HATIRLATMA KARTLARI -->
    <section class="bg-gradient-to-r from-slate-900 to-slate-950 text-white p-6 sm:p-7 rounded-2xl border-2 border-amber-500/80 shadow-xl relative no-print">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800">
        <div class="flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-amber-500 text-slate-950 flex items-center justify-center font-black text-sm">
            🎯
          </span>
          <div>
            <h2 class="text-lg sm:text-xl font-extrabold text-white tracking-tight flex items-center gap-2">
              <span>Toplantı Konuşma Rehberi & Hatırlatma Kartları</span>
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">
                Sana Özel Hızlı Bakış
              </span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">Toplantı boyunca takıldığın an göz ucuyla bakacağın altın konuşma adımları</p>
          </div>
        </div>

        <button 
          id="toggleGuideBtn" 
          type="button"
          onclick="toggleGuide()"
          class="text-xs px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition-all cursor-pointer font-medium"
        >
          Gizle / Göster
        </button>
      </div>

      <!-- 6 Adımlı Hatırlatma Grid -->
      <div id="guideContent" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pt-5 transition-all">
        
        <!-- Adım 1 -->
        <div class="bg-slate-850 p-4 rounded-xl border border-slate-700/80 space-y-2">
          <div class="flex items-center gap-2 text-amber-400 text-xs font-black uppercase tracking-wider">
            <span class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-300 flex items-center justify-center text-[11px]">1</span>
            <span>Hal-Hatır & Çay (İlk 3-5 Dk)</span>
          </div>
          <p class="text-xs text-slate-300 font-medium leading-relaxed">
            Hemen işe ve paraya girme. Çay söyle, esnafla bağ kur:
          </p>
          <div class="text-[11px] font-mono text-amber-200/90 bg-slate-900/90 p-2.5 rounded-lg border border-slate-800 leading-snug">
            "Ali Bey işler nasıl? Sanayi tarafı hareketli mi bu aralar?"
          </div>
        </div>

        <!-- Adım 2 -->
        <div class="bg-slate-850 p-4 rounded-xl border border-slate-700/80 space-y-2">
          <div class="flex items-center gap-2 text-emerald-400 text-xs font-black uppercase tracking-wider">
            <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-300 flex items-center justify-center text-[11px]">2</span>
            <span>Göz Doyurma & 94 vs 74 Kıyası</span>
          </div>
          <p class="text-xs text-slate-300 font-medium leading-relaxed">
            Laptopta siteyi aç, F12 mobil yap ve referans darbesini vur:
          </p>
          <div class="text-[11px] font-mono text-emerald-200/90 bg-slate-900/90 p-2.5 rounded-lg border border-slate-800 leading-snug">
            "Sizin referans site 74 puan aldı (4 sn). Bizimki 94 puan (0.3 sn)! Hızlı site Google Ads'te %40 ucuza tıklar."
          </div>
        </div>

        <!-- Adım 3 -->
        <div class="bg-slate-850 p-4 rounded-xl border border-slate-700/80 space-y-2">
          <div class="flex items-center gap-2 text-sky-400 text-xs font-black uppercase tracking-wider">
            <span class="w-5 h-5 rounded-full bg-sky-500/20 text-sky-300 flex items-center justify-center text-[11px]">3</span>
            <span>Aşağıdaki 5 Kutuyu Doldur</span>
          </div>
          <p class="text-xs text-slate-300 font-medium leading-relaxed">
            Sayfayı aşağı kaydır, soruları sorup klavyeyle takır takır not al:
          </p>
          <div class="text-[11px] font-mono text-sky-200/90 bg-slate-900/90 p-2.5 rounded-lg border border-slate-800 leading-snug">
            "Ali Bey dükkanı tam oturtmak için birkaç sorum var: Seyyar kantar var mı? Klimayı usta mı söküyor?"
          </div>
        </div>

        <!-- Adım 4 -->
        <div class="bg-slate-850 p-4 rounded-xl border border-slate-700/80 space-y-2">
          <div class="flex items-center gap-2 text-orange-400 text-xs font-black uppercase tracking-wider">
            <span class="w-5 h-5 rounded-full bg-orange-500/20 text-orange-300 flex items-center justify-center text-[11px]">4</span>
            <span>Köprü & 25.000 ₺ Teklifi</span>
          </div>
          <p class="text-xs text-slate-300 font-medium leading-relaxed">
            Notlar bitince arkana yaslan, 15 binin sadece site olduğunu belirt:
          </p>
          <div class="text-[11px] font-mono text-orange-200/90 bg-slate-900/90 p-2.5 rounded-lg border border-slate-800 leading-snug">
            "15 bin temel yazılımdı. Ajanslar buna 80-100 bin istiyor. Lansmanla 25.000 ₺ anahtar teslim bağlayalım + 5.000 ₺ yönetim."
          </div>
        </div>

        <!-- Adım 5 -->
        <div class="bg-slate-850 p-4 rounded-xl border border-slate-700/80 space-y-2">
          <div class="flex items-center gap-2 text-purple-400 text-xs font-black uppercase tracking-wider">
            <span class="w-5 h-5 rounded-full bg-purple-500/20 text-purple-300 flex items-center justify-center text-[11px]">5</span>
            <span>Taksi vs Kendi Araban</span>
          </div>
          <p class="text-xs text-slate-300 font-medium leading-relaxed">
            "Reklam ne zaman biter, para azalır mı?" derse vurucu benzetme:
          </p>
          <div class="text-[11px] font-mono text-purple-200/90 bg-slate-900/90 p-2.5 rounded-lg border border-slate-800 leading-snug">
            "Google Ads taksidir (hemen yarın müşteri). SEO arabadır (1-2 ayda bedava). 94 puanla tıklama masrafınız zamanla yarı yarıya düşecek."
          </div>
        </div>

        <!-- Adım 6 -->
        <div class="bg-slate-850 p-4 rounded-xl border border-slate-700/80 space-y-2">
          <div class="flex items-center gap-2 text-emerald-300 text-xs font-black uppercase tracking-wider">
            <span class="w-5 h-5 rounded-full bg-emerald-500/30 text-emerald-200 flex items-center justify-center text-[11px]">6</span>
            <span>Kapanış & El Sıkışma</span>
          </div>
          <p class="text-xs text-slate-300 font-medium leading-relaxed">
            Görsel sözünü al, kararı en alttaki karar kutusuna yaz ve elini uzat:
          </p>
          <div class="text-[11px] font-mono text-emerald-300 bg-slate-900/90 p-2.5 rounded-lg border border-slate-800 leading-snug">
            "Siz bana WhatsApp'tan dükkan/araç fotoğraflarını atın, haftaya reklamı açıp telefonları çaldıralım. Hayırlı olsun diyelim mi?"
          </div>
        </div>

      </div>
    </section>

    <!-- BÖLÜM 1: FİYAT VE SEÇENEKLER VİTRİNİ -->
    <section>
      <div class="mb-6">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-700 bg-amber-100 px-2.5 py-1 rounded-md border border-amber-200">1. AŞAMA</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-2">
          Fiyat & Yatırım Paketleri
        </h2>
        <p class="text-sm text-slate-600 mt-1">Müşterinin ihtiyaç ve bütçesine göre sunulacak 3 net alternatif.</p>
      </div>

      <!-- 3 Paket Kartı -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- PAKET 1: Sadece Web Sitesi -->
        <div class="rounded-2xl bg-white border border-slate-200 p-6 flex flex-col justify-between hover:border-slate-300 transition-all shadow-sm">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 border border-slate-200">
                Temel Teslim
              </span>
              <span class="text-xs text-slate-500 font-medium">Tek Seferlik</span>
            </div>
            
            <h3 class="text-xl font-bold text-slate-900">Sadece Web Sitesi</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Söz verilen 27 sayfalık sitenin devri ve alan adı kurulumu. Reklam ve arama motoru tırmanışı yapılmaz.
            </p>

            <div class="pt-2 border-t border-slate-100">
              <div class="text-3xl font-extrabold text-slate-900">17.500 ₺</div>
              <div class="text-[11px] text-slate-500 font-medium mt-1">15.000 ₺ Yazılım + 2.500 ₺ Domain/Altyapı</div>
            </div>

            <ul class="space-y-2.5 text-xs text-slate-700 pt-2 font-medium">
              <li class="flex items-start gap-2.5">
                <span class="check-bullet">✓</span>
                <span>Astro 5 Altyapısı (0.3 sn Açılış)</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="check-bullet">✓</span>
                <span>2. El Klima/Kombi Landing Page</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="check-bullet">✓</span>
                <span>Domain, SSL ve Bulut Kurulumu</span>
              </li>
              <li class="flex items-start gap-2.5 text-slate-400">
                <span class="cross-bullet">✕</span>
                <span>Google Ads Reklam Kurulumu Yok</span>
              </li>
              <li class="flex items-start gap-2.5 text-slate-400">
                <span class="cross-bullet">✕</span>
                <span>İlçe SEO & Sıralama Çalışması Yok</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- PAKET 2: Bölge Lideri (Tavsiye Edilen) -->
        <div class="rounded-2xl bg-gradient-to-b from-amber-50/50 to-white border-2 border-amber-500 p-6 flex flex-col justify-between relative shadow-lg shadow-amber-500/10 md:scale-102">
          <div class="absolute -top-3.5 right-6 px-3 py-1 rounded-full bg-amber-500 text-slate-950 text-xs font-black tracking-wide uppercase shadow-md">
            ⭐ EN ÇOK TAVSİYE EDİLEN
          </div>

          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-amber-100 text-amber-900 border border-amber-300">
                Anahtar Teslim Büyüme
              </span>
              <span class="text-xs text-amber-800 font-semibold">Lansman Paketi</span>
            </div>
            
            <h3 class="text-xl font-bold text-slate-900">Bölge Lideri & Reklam</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Site + 8 Sanayi İlçesi SEO'su + Google Ads profesyonel kurulumu. İlk günden telefon çaldırır.
            </p>

            <div class="pt-2 border-t border-amber-200">
              <div class="flex items-baseline gap-2">
                <span class="text-3xl font-extrabold text-amber-600">25.000 ₺</span>
                <span class="text-xs line-through text-slate-400 font-medium">27.500 ₺</span>
              </div>
              <div class="text-xs text-emerald-800 font-bold mt-1 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 inline-block">
                + Aylık 5.000 ₺ (Reklam Takibi, Fiyat Güncelleme)
              </div>
            </div>

            <ul class="space-y-2.5 text-xs text-slate-900 pt-2 font-semibold">
              <li class="flex items-start gap-2.5">
                <span class="star-bullet">★</span>
                <span><strong>Web Sitesi</strong> + Domain & Hosting Hediyesi</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="star-bullet">★</span>
                <span><strong>8 İlçe Yerel SEO:</strong> İkitelli, Gebze, Ümraniye vb.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="star-bullet">★</span>
                <span><strong>Google Ads Kurulumu:</strong> 150+ Negatif Kelime</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="star-bullet">★</span>
                <span><strong>Dönüşüm Takibi:</strong> WhatsApp & Arama Sayacı</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="star-bullet">★</span>
                <span><strong>İlk Ay Reklam & Bütçe Yönetimi Dahil</strong></span>
              </li>
            </ul>
          </div>
        </div>

        <!-- PAKET 3: Agresif İstanbul Hakimiyeti -->
        <div class="rounded-2xl bg-white border border-slate-200 p-6 flex flex-col justify-between hover:border-slate-300 transition-all shadow-sm">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-purple-100 text-purple-900 border border-purple-200">
                Tam Yetki Ajans
              </span>
              <span class="text-xs text-slate-500 font-medium">Yüksek Hacim</span>
            </div>
            
            <h3 class="text-xl font-bold text-slate-900">Agresif Hakimiyet</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Tüm İstanbul OSB'leri için ek 20 ilçe sayfası + Google Haritalar yönetimi + haftalık LME fiyat güncellemesi.
            </p>

            <div class="pt-2 border-t border-slate-100">
              <div class="text-3xl font-extrabold text-slate-900">35.000 ₺</div>
              <div class="text-xs text-purple-800 font-bold mt-1 bg-purple-50 px-2 py-0.5 rounded border border-purple-200 inline-block">
                + Aylık 8.500 ₺ (Tam Dijital Yönetim)
              </div>
            </div>

            <ul class="space-y-2.5 text-xs text-slate-700 pt-2 font-medium">
              <li class="flex items-start gap-2.5">
                <span class="check-bullet" style="color: #7e22ce; background: #faf5ff; border-color: #e9d5ff">✓</span>
                <span>Bölge Lideri Paketindeki Her Şey</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="check-bullet" style="color: #7e22ce; background: #faf5ff; border-color: #e9d5ff">✓</span>
                <span>Tüm İstanbul OSB'lerine 20+ Özel Sayfa</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="check-bullet" style="color: #7e22ce; background: #faf5ff; border-color: #e9d5ff">✓</span>
                <span>Google Business (Harita) Sıralama Yönetimi</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="check-bullet" style="color: #7e22ce; background: #faf5ff; border-color: #e9d5ff">✓</span>
                <span>Haftalık Borsa Endeksli Fiyat Güncellemesi</span>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </section>

    <!-- BÖLÜM 2: SAHA & OPERASYONEL MÜLAKAT (SERBEST NOT ALMA ALANLARI) -->
    <section class="space-y-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 bg-emerald-100 px-2.5 py-1 rounded-md border border-emerald-200">2. AŞAMA</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-2">
          Saha & Operasyon Not Alma Alanları
        </h2>
        <p class="text-sm text-slate-600 mt-1">
          Müşteriyle konuşurken her konunun altındaki geniş alana rahatça notlarınızı alın. Yazdıklarınız anında otomatik kaydedilir.
        </p>
      </div>

      <div class="space-y-6">

        <!-- Kategori 1: Saha & Lojistik Operasyonu -->
        <div class="rounded-2xl bg-white border border-slate-200 p-6 space-y-3 shadow-sm hover:border-amber-300 transition-colors">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
              <span class="text-lg">🚛</span>
              <span>1. Saha & Lojistik Operasyonu</span>
            </h3>
            <span class="text-xs text-slate-500 font-medium">Kantar, Araç Filosu, Adrese Alım Şartı, Söküm Ekibi</span>
          </div>
          <p class="text-xs text-slate-500 font-medium">
            💡 <em>Müşteriye sorulacaklar:</em> Adrese gitmek için alt sınır var mı? Araçta seyyar elektronik kantar/baskül var mı? Araç tipleri neler? Klimayı/kombiyi duvardan usta mı söküyor?
          </p>
          <textarea 
            id="note_saha_lojistik" 
            rows="4" 
            placeholder="Örn: 1 klima veya 20 kg bakır için kapıya gidiliyor. Araçta 150 kg seyyar kantar var, tonajlıda resmi kantara çekiliyor. 2 kamyonet var. Klimayı hasarsız gazını toplayarak ustamız söküyor..."
            class="w-full text-xs font-mono p-4 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 leading-relaxed shadow-2xs"
          ></textarea>
        </div>

        <!-- Kategori 2: İletişim & Teklif Verme Kanalları -->
        <div class="rounded-2xl bg-white border border-slate-200 p-6 space-y-3 shadow-sm hover:border-emerald-300 transition-colors">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
              <span class="text-lg">📱</span>
              <span>2. İletişim & Teklif Verme Kanalları</span>
            </h3>
            <span class="text-xs text-slate-500 font-medium">WhatsApp Görüntülü Fiyat, Telefonlar, Çalışma Saatleri</span>
          </div>
          <p class="text-xs text-slate-500 font-medium">
            💡 <em>Müşteriye sorulacaklar:</em> WhatsApp görüntülü aramayla canlı kamerayla fiyat verme vaadi koyalım mı? Kesin telefon ve WhatsApp hatları hangileri? Pazar günü ve akşam açık mı?
          </p>
          <textarea 
            id="note_iletisim_kanallari" 
            rows="4" 
            placeholder="Örn: WhatsApp görüntülü arama vaadi koyulsun (çok iyi olur dedi). 0541 623 88 81 tek numara. Pazar günleri adresten alım için açık, 7/24 telefon açık..."
            class="w-full text-xs font-mono p-4 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 leading-relaxed shadow-2xs"
          ></textarea>
        </div>

        <!-- Kategori 3: Medya & Fotoğraf/Video Arşivi -->
        <div class="rounded-2xl bg-white border border-slate-200 p-6 space-y-3 shadow-sm hover:border-sky-300 transition-colors">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
              <span class="text-lg">📸</span>
              <span>3. Fotoğraf & Video Arşivi (Müşteriden Alınacaklar)</span>
            </h3>
            <span class="text-xs text-slate-500 font-medium">Dükkan, Tabela, Kamyonet, Tartım Videosu, Referanslar</span>
          </div>
          <p class="text-xs text-slate-500 font-medium">
            💡 <em>Müşteriye sorulacaklar:</em> Dükkan/kantar fotoğrafları ne zaman gelecek? Kamyonette yükleme yaparken fotoğraflar var mı? 10-15 saniyelik doğal kantar tartım videosu çekebilir mi? Geçmiş fabrika işleri var mı?
          </p>
          <textarea 
            id="note_medya_arsiv" 
            rows="4" 
            placeholder="Örn: Dükkan tabelası ve kantar fotoğrafını yarın WhatsApp'tan atacak. Kamyonetin arkasında klima yüklü 2 kare var. İlk adrese gittiğinde 15 saniyelik tartım videosu çekip yollayacak..."
            class="w-full text-xs font-mono p-4 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 leading-relaxed shadow-2xs"
          ></textarea>
        </div>

        <!-- Kategori 4: Ödeme, Fatura & Hurda Kapsamı -->
        <div class="rounded-2xl bg-white border border-slate-200 p-6 space-y-3 shadow-sm hover:border-orange-300 transition-colors">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
              <span class="text-lg">💵</span>
              <span>4. Ödeme, Fatura & Hurda Kapsamı</span>
            </h3>
            <span class="text-xs text-slate-500 font-medium">Ödeme Şekli, 2. El Değeri, Fatura, Alınmayan Hurdalar</span>
          </div>
          <p class="text-xs text-slate-500 font-medium">
            💡 <em>Müşteriye sorulacaklar:</em> Ödeme kapıda nakit mi/IBAN mı? Çalışan klimaya 2. el değeri veriliyor mu? Fabrikalara fatura/gider pusulası kesiliyor mu? Kesinlikle ALINMAYAN hurdalar (reklam negatifleri)?
          </p>
          <textarea 
            id="note_odeme_kapsam" 
            rows="4" 
            placeholder="Örn: Kapıda anında peşin nakit veya anında FAST transfer. Çalışan Daikin/Mitsubishi klimalara ekstra 2. el parası veriliyor. Tevkifatlı fatura kesebiliyor. ALINMAYAN: Kağıt, plastik, cam, moloz kesinlikle alınmaz..."
            class="w-full text-xs font-mono p-4 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 leading-relaxed shadow-2xs"
          ></textarea>
        </div>

        <!-- Kategori 5: Dükkan Adresi & Hizmet Bölgeleri -->
        <div class="rounded-2xl bg-white border border-slate-200 p-6 space-y-3 shadow-sm hover:border-indigo-300 transition-colors">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
              <span class="text-lg">📍</span>
              <span>5. Dükkan Adresi & Hizmet Bölgeleri (Google Haritalar)</span>
            </h3>
            <span class="text-xs text-slate-500 font-medium">Açık Adres, Harita Profili, Öncelikli İlçeler</span>
          </div>
          <p class="text-xs text-slate-500 font-medium">
            💡 <em>Müşteriye sorulacaklar:</em> Dükkanın tam açık adresi nedir? Mevcut Google Harita kaydı var mı, yetkisi alınacak mı? En hızlı ulaştığı öncelikli ilçeler hangileri?
          </p>
          <textarea 
            id="note_bolge_adres" 
            rows="4" 
            placeholder="Örn: Güngören Sanayi Mah. Hurdacılar Sitesi No: 12. Google Harita kaydı var ama eski, yönetim yetkisini bize devredecek. En çok Bağcılar, İkitelli, Başakşehir, Avcılar, Esenyurt ve Gebze'ye gidiyor..."
            class="w-full text-xs font-mono p-4 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 leading-relaxed shadow-2xs"
          ></textarea>
        </div>

      </div>
    </section>

    <!-- BÖLÜM 3: MÜŞTERİNİN ÖZEL İSTEKLERİ & TOPLANTI NOT DEFTERİ -->
    <section class="space-y-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-purple-800 bg-purple-100 px-2.5 py-1 rounded-md border border-purple-200">3. AŞAMA</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-2">
          Müşterinin Özel İstekleri & Toplantı Kararları
        </h2>
        <p class="text-sm text-slate-600 mt-1">
          Müşterinin ağzından çıkan özel istekleri, revize taleplerini ve toplantı sonucunu buraya yazın.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Sol Not Defteri -->
        <div class="rounded-2xl bg-white border border-slate-200 p-6 space-y-3 shadow-sm">
          <label class="block text-xs font-extrabold uppercase tracking-wider text-slate-900">
            ✍️ Müşterinin Sitede Özellikle İstediği Şeyler / Revizeler:
          </label>
          <textarea 
            id="meeting_custom_notes" 
            rows="8" 
            placeholder="- Örneğin: 'Logodaki rengi biraz daha koyu yapalım'&#10;- 'Klimada inverter modelleri ayrıca belirtelim'&#10;- 'Pazartesi günü araç fotoğraflarını WhatsApp'tan atacağım'..."
            class="w-full text-xs font-mono p-4 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 leading-relaxed shadow-2xs"
          ></textarea>
        </div>

        <!-- Sağ Karar Defteri -->
        <div class="rounded-2xl bg-amber-50/40 border border-amber-200 p-6 space-y-3 shadow-sm">
          <label class="block text-xs font-extrabold uppercase tracking-wider text-amber-900">
            🤝 Toplantı Sonucu & Varılan Anlaşma (Özet):
          </label>
          <textarea 
            id="meeting_outcome_notes" 
            rows="8" 
            placeholder="Örn:&#10;• Seçilen Paket: Bölge Lideri (25.000 TL Anahtar Teslim)&#10;• Ödeme Planı: 15.000 TL peşin verildi, kalan 10.000 TL yayında verilecek&#10;• Google Ads Bütçesi: Günlük 300 TL kart bağlandı&#10;• Teslim Tarihi: Çarşamba günü tam yayın..."
            class="w-full text-xs font-mono p-4 rounded-xl bg-white border border-amber-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 leading-relaxed shadow-2xs"
          ></textarea>
        </div>

      </div>
    </section>

    <!-- FOOTER & RESET -->
    <footer class="pt-8 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-500 no-print">
      <div>
        <span>Durmaz Metal Dijital Dönüşüm Dosyası • Gizlidir</span>
      </div>
      <button 
        id="resetBtn" 
        class="text-xs text-rose-600 hover:text-rose-700 underline font-semibold cursor-pointer"
      >
        Formu ve Notları Sıfırla (Temizle)
      </button>
    </footer>

  </main>

  <!-- JAVASCRIPT: AUTOSAVE & ACTIONS -->
  <script is:inline>
    const STORAGE_KEY = 'durmaz_metal_meeting_data_v2';

    const textareas = [
      'note_saha_lojistik',
      'note_iletisim_kanallari',
      'note_medya_arsiv',
      'note_odeme_kapsam',
      'note_bolge_adres',
      'meeting_custom_notes',
      'meeting_outcome_notes'
    ];

    const saveIndicator = document.getElementById('saveIndicator');

    function flashSave() {
      if (!saveIndicator) return;
      saveIndicator.style.opacity = '1';
      setTimeout(() => {
        saveIndicator.style.opacity = '0';
      }, 1500);
    }

    function saveData() {
      const data = {};
      textareas.forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          data[id] = el.value;
        }
      });
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      flashSave();
    }

    function loadData() {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      try {
        const data = JSON.parse(raw);
        textareas.forEach(id => {
          const el = document.getElementById(id);
          if (el && data[id] !== undefined) {
            el.value = data[id];
          }
        });
      } catch (err) {
        console.error('Veri yüklenirken hata:', err);
      }
    }

    textareas.forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      el.addEventListener('input', saveData);
      el.addEventListener('change', saveData);
    });

    document.getElementById('copyBtn')?.addEventListener('click', () => {
      const outcome = document.getElementById('meeting_outcome_notes')?.value || 'Belirtilmedi';
      const custom = document.getElementById('meeting_custom_notes')?.value || 'Belirtilmedi';
      const saha = document.getElementById('note_saha_lojistik')?.value || 'Not alınmadı';
      const iletisim = document.getElementById('note_iletisim_kanallari')?.value || 'Not alınmadı';
      const medya = document.getElementById('note_medya_arsiv')?.value || 'Not alınmadı';
      const odeme = document.getElementById('note_odeme_kapsam')?.value || 'Not alınmadı';
      const bolge = document.getElementById('note_bolge_adres')?.value || 'Not alınmadı';

      let text = `=========================================\n`;
      text += `HURDACI DURMAZ METAL - TOPLANTI BRİFİNGİ\n`;
      text += `Tarih: ${new Date().toLocaleDateString('tr-TR')} ${new Date().toLocaleTimeString('tr-TR')}\n`;
      text += `=========================================\n\n`;

      text += `1. ALINAN KARAR & ANLAŞMA:\n${outcome}\n\n`;
      text += `2. MÜŞTERİNİN ÖZEL İSTEKLERİ & REVİZELERİ:\n${custom}\n\n`;
      text += `3. SAHA & LOJİSTİK OPERASYONU:\n${saha}\n\n`;
      text += `4. İLETİŞİM & TEKLİF KANALLARI:\n${iletisim}\n\n`;
      text += `5. MEDYA & FOTOĞRAF/VİDEO ARŞİVİ:\n${medya}\n\n`;
      text += `6. ÖDEME, FATURA & HURDA KAPSAMI:\n${odeme}\n\n`;
      text += `7. DÜKKAN ADRESİ & BÖLGELER:\n${bolge}\n`;

      navigator.clipboard.writeText(text).then(() => {
        alert('Tüm toplantı notları düzenli rapor halinde panoya kopyalandı!');
      });
    });

    document.getElementById('downloadBtn')?.addEventListener('click', () => {
      const outcome = document.getElementById('meeting_outcome_notes')?.value || 'Belirtilmedi';
      const custom = document.getElementById('meeting_custom_notes')?.value || 'Belirtilmedi';
      const saha = document.getElementById('note_saha_lojistik')?.value || 'Not alınmadı';
      const iletisim = document.getElementById('note_iletisim_kanallari')?.value || 'Not alınmadı';
      const medya = document.getElementById('note_medya_arsiv')?.value || 'Not alınmadı';
      const odeme = document.getElementById('note_odeme_kapsam')?.value || 'Not alınmadı';
      const bolge = document.getElementById('note_bolge_adres')?.value || 'Not alınmadı';

      let text = `HURDACI DURMAZ METAL - TOPLANTI NOTLARI\n`;
      text += `Tarih: ${new Date().toLocaleDateString('tr-TR')}\n\n`;
      text += `--- ALINAN KARAR ---\n${outcome}\n\n`;
      text += `--- MÜŞTERİNİN İSTEKLERİ ---\n${custom}\n\n`;
      text += `--- SAHA & LOJİSTİK ---\n${saha}\n\n`;
      text += `--- İLETİŞİM KANALLARI ---\n${iletisim}\n\n`;
      text += `--- MEDYA VE FOTOĞRAFLAR ---\n${medya}\n\n`;
      text += `--- ÖDEME & HURDA KAPSAMI ---\n${odeme}\n\n`;
      text += `--- BÖLGE VE ADRES ---\n${bolge}\n`;

      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `durmaz-metal-toplanti-notlari-${new Date().toISOString().slice(0, 10)}.txt`;
      a.click();
    });

    document.getElementById('resetBtn')?.addEventListener('click', () => {
      if (confirm('Tüm notları temizlemek istediğinize emin misiniz?')) {
        localStorage.removeItem(STORAGE_KEY);
        textareas.forEach(id => {
          const el = document.getElementById(id);
          if (el) el.value = '';
        });
        alert('Tüm notlar temizlendi.');
      }
    });

    // Toggle cheat sheet guide
    window.toggleGuide = function() {
      const guide = document.getElementById('guideContent');
      const btn = document.getElementById('toggleGuideBtn');
      if (!guide) return;
      if (guide.classList.contains('hidden')) {
        guide.classList.remove('hidden');
        if (btn) btn.textContent = 'Gizle';
      } else {
        guide.classList.add('hidden');
        if (btn) btn.textContent = 'Göster';
      }
    };

    loadData();
  </script>

</body>
</html>
