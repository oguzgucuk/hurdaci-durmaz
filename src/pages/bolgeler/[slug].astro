---
import MainLayout from '../../layouts/MainLayout.astro';
import company from '../../data_files/company.json';
import districts from '../../data_files/districts.json';

export async function getStaticPaths() {
  return districts.map((district) => ({
    params: { slug: district.slug },
    props: { district },
  }));
}

const { district } = Astro.props;

const pageTitle = `${district.name} — Adresten Hurda & 2. El Klima Alımı | Durmaz Metal`;
const pageDesc = `${district.name} bölgesinde bakır, sarı, demir hurdaları ve 2. el klima alımı. ${district.deliveryTime} içinde adrese gelen mobil kantar ve anında nakit ödeme.`;
const waUrl = `https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(`Merhaba Durmaz Metal, ${district.name} bölgesinden hurda satmak istiyorum. Adresime araç ve fiyat teklifi talep ediyorum.`)}`;
const callUrl = `tel:${company.phoneRaw}`;
---

<MainLayout title={pageTitle} description={pageDesc}>
  <!-- District Banner -->
  <section class="bg-gradient-to-b from-[#0e3b2e] to-[#134939] text-white py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-300 mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white">Ana Sayfa</a>
          <span>/</span>
          <a href="/bolgeler" class="hover:text-white">Bölgeler</a>
          <span>/</span>
          <span class="text-amber-400 font-semibold">{district.shortName}</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-emerald-300 text-xs sm:text-sm font-semibold mb-4 border border-white/15">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{district.region} · Servis Süresi: {district.deliveryTime}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
          {district.headline}
        </h1>
        <p class="text-base sm:text-lg text-slate-200 leading-relaxed mb-6">
          {district.description}
        </p>

        <!-- Fast Contact Buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[#ea580c] hover:bg-[#c2410c] text-white font-bold text-sm sm:text-base shadow-lg transition-all"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.34C9.36 7.34 9.09 7.4 8.87 7.65C8.64 7.89 8 8.49 8 9.72C8 10.95 8.89 12.14 9.01 12.31C9.14 12.47 10.77 14.97 13.25 16.05C13.84 16.31 14.3 16.46 14.66 16.58C15.26 16.77 15.8 16.74 16.24 16.68C16.73 16.61 17.74 16.07 17.95 15.48C18.16 14.89 18.16 14.38 18.1 14.28C18.04 14.18 17.88 14.12 17.64 14C17.4 13.88 16.21 13.3 15.99 13.22C15.77 13.14 15.61 13.1 15.45 13.34C15.29 13.59 14.83 14.12 14.69 14.28C14.55 14.44 14.41 14.47 14.17 14.35C13.93 14.23 12.92 13.89 11.72 12.82C10.79 11.99 10.16 10.96 10.04 10.76C9.92 10.56 10.03 10.45 10.15 10.33C10.26 10.22 10.4 10.04 10.52 9.9C10.64 9.76 10.68 9.66 10.76 9.5C10.84 9.34 10.8 9.2 10.74 9.08C10.68 8.96 10.22 7.83 10.03 7.37C9.84 6.92 9.65 6.98 9.53 7.34Z"/>
            </svg>
            <span>{district.shortName} WhatsApp Araç Talebi</span>
          </a>
          <a
            href={callUrl}
            class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-bold text-sm sm:text-base border border-white/20 transition-all"
          >
            <span>Hemen Ara: {company.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- District Details Content -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left 2 Cols: Service Features -->
        <div class="lg:col-span-2 space-y-8">
          
          <!-- Box 1: Why Choose in this district -->
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
            <h2 class="text-2xl font-bold text-slate-900 mb-4">
              {district.name} Adresten Hurda Alım Süreci
            </h2>
            <p class="text-slate-600 leading-relaxed mb-6">
              Hurdacı Durmaz Metal olarak {district.shortName} semtinde ve çevresinde atölyeler, fabrikalar, şantiyeler ve bireysel konutlar için yerinde hurda tartım ve nakit satın alma hizmeti veriyoruz. {district.addressNote}
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-start gap-3">
                <span class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0 font-bold">1</span>
                <div>
                  <h3 class="font-bold text-slate-900 text-sm">Hızlı Konum & Araç Sevk</h3>
                  <p class="text-xs text-slate-600 mt-0.5">{district.deliveryTime} içinde özel donanımlı aracımız kapınızda.</p>
                </div>
              </div>
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-start gap-3">
                <span class="w-8 h-8 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center shrink-0 font-bold">2</span>
                <div>
                  <h3 class="font-bold text-slate-900 text-sm">Gözünüzün Önünde Kantar</h3>
                  <p class="text-xs text-slate-600 mt-0.5">Kalibre dijital elektronik tartı ile şeffaf tartım ve kantar fişi.</p>
                </div>
              </div>
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-start gap-3">
                <span class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0 font-bold">3</span>
                <div>
                  <h3 class="font-bold text-slate-900 text-sm">Anında Peşin Ödeme</h3>
                  <p class="text-xs text-slate-600 mt-0.5">Tartım tamamlandığı an elden nakit veya anında banka transferi.</p>
                </div>
              </div>
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-start gap-3">
                <span class="w-8 h-8 rounded-lg bg-orange-100 text-orange-800 flex items-center justify-center shrink-0 font-bold">4</span>
                <div>
                  <h3 class="font-bold text-slate-900 text-sm">Söküm & Taşıma</h3>
                  <p class="text-xs text-slate-600 mt-0.5">Ağır metaller, kazanlar ve klima sökümleri kendi ustalarımızca yapılır.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Box 2: Popular Metals in this district -->
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4">
              {district.shortName} Bölgesinde En Çok Alımını Yaptığımız Hurdalar
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {district.popularMetals.map((metal) => (
                <div class="flex items-center gap-3 p-3 rounded-lg bg-slate-50 border border-slate-200/80">
                  <span class="w-2.5 h-2.5 rounded-full bg-[#ea580c]"></span>
                  <span class="text-sm font-bold text-slate-800">{metal}</span>
                </div>
              ))}
            </div>
            <div class="mt-6 pt-6 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
              <span class="text-sm text-slate-600 font-medium">Fiyatları merak mı ediyorsunuz?</span>
              <a href="/hurda-fiyatlari" class="text-sm font-bold text-emerald-700 hover:text-emerald-800 underline">
                Güncel Hurda Fiyat Listesini İncele →
              </a>
            </div>
          </div>

        </div>

        <!-- Right Col: Sticky Fast Contact Sidebar -->
        <div class="space-y-6">
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm sticky top-24">
            <h3 class="text-lg font-bold text-slate-900 mb-2">
              {district.shortName} Hurda Çağrı Hattı
            </h3>
            <p class="text-xs text-slate-600 mb-6">
              Fotoğraf gönderin veya doğrudan arayın; adresinize en yakın mobil hurda aracımızı hemen yönlendirelim.
            </p>

            <div class="space-y-3">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full flex items-center justify-center gap-2 py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md transition-all"
              >
                <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.34C9.36 7.34 9.09 7.4 8.87 7.65C8.64 7.89 8 8.49 8 9.72C8 10.95 8.89 12.14 9.01 12.31C9.14 12.47 10.77 14.97 13.25 16.05C13.84 16.31 14.3 16.46 14.66 16.58C15.26 16.77 15.8 16.74 16.24 16.68C16.73 16.61 17.74 16.07 17.95 15.48C18.16 14.89 18.16 14.38 18.1 14.28C18.04 14.18 17.88 14.12 17.64 14C17.4 13.88 16.21 13.3 15.99 13.22C15.77 13.14 15.61 13.1 15.45 13.34C15.29 13.59 14.83 14.12 14.69 14.28C14.55 14.44 14.41 14.47 14.17 14.35C13.93 14.23 12.92 13.89 11.72 12.82C10.79 11.99 10.16 10.96 10.04 10.76C9.92 10.56 10.03 10.45 10.15 10.33C10.26 10.22 10.4 10.04 10.52 9.9C10.64 9.76 10.68 9.66 10.76 9.5C10.84 9.34 10.8 9.2 10.74 9.08C10.68 8.96 10.22 7.83 10.03 7.37C9.84 6.92 9.65 6.98 9.53 7.34Z"/>
                </svg>
                <span>WhatsApp'tan Konum At</span>
              </a>

              <a
                href={callUrl}
                class="w-full flex items-center justify-center gap-2 py-3.5 px-4 rounded-xl bg-[#ea580c] hover:bg-[#c2410c] text-white font-bold text-sm shadow-md transition-all"
              >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>{company.phone}</span>
              </a>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 text-xs text-slate-500 space-y-1.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Hassas Dijital Kalibre Terazi</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Kapıda Anında Nakit / Havale</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>7/24 Adresten Hurda Alımı</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</MainLayout>
