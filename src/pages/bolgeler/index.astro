---
import MainLayout from '../../layouts/MainLayout.astro';
import company from '../../data_files/company.json';
import districts from '../../data_files/districts.json';

const pageTitle = "Hurdacı Bölgeleri — İstanbul & Gebze Adresten Hurda Alımı | Durmaz Metal";
const pageDesc = "İstanbul Avrupa Yakası, Anadolu Yakası ve Kocaeli Gebze genelinde 30-45 dakikada adrese gelen gezici mobil hurda araçlarımız ve kantar filomuzla hizmetinizdeyiz.";
const waUrl = `https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent('Merhaba Durmaz Metal, bulunduğum bölgeden adresten hurda alımı talebinde bulunmak istiyorum.')}`;
---

<MainLayout title={pageTitle} description={pageDesc}>
  <!-- Header Banner -->
  <section class="bg-gradient-to-b from-[#0e3b2e] to-[#134939] text-white py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 rounded-full bg-white/10 text-emerald-300 text-xs sm:text-sm font-semibold mb-4 border border-white/15">
          İstanbul Geneli & Gebze Sanayi Aksı
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
          Hizmet Verdiğimiz <span class="text-amber-400">Hurdacı Bölgeleri</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-200 leading-relaxed">
          Gezici mobil hurda araçlarımız ve hassas elektronik terazimizle çağrınızdan itibaren 30-45 dakika içinde adresinize ulaşıyoruz. Yerinde tartıyor, kapıda peşin nakit ödüyoruz.
        </p>
      </div>
    </div>
  </section>

  <!-- District Cards Grid -->
  <section class="py-12 lg:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {districts.map((district) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:shadow-md hover:border-emerald-500/40 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="px-2.5 py-1 text-xs font-bold rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200">
                  {district.region}
                </span>
                <span class="text-xs font-semibold text-slate-500 flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {district.deliveryTime}
                </span>
              </div>

              <h2 class="text-xl font-bold text-slate-900 mb-2">
                <a href={`/bolgeler/${district.slug}`} class="hover:text-emerald-700 transition-colors">
                  {district.name}
                </a>
              </h2>

              <p class="text-sm text-slate-600 line-clamp-3 mb-4 leading-relaxed">
                {district.description}
              </p>

              <!-- Popular tags -->
              <div class="space-y-1 mb-6">
                <span class="text-xs font-semibold text-slate-400 block uppercase tracking-wider">
                  Yoğun Alım:
                </span>
                <div class="flex flex-wrap gap-1.5">
                  {district.popularMetals.slice(0, 3).map((metal) => (
                    <span class="px-2 py-0.5 text-xs bg-slate-100 text-slate-700 rounded-md">
                      {metal}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <a
                href={`/bolgeler/${district.slug}`}
                class="text-xs sm:text-sm font-bold text-[#0e3b2e] hover:text-[#ea580c] flex items-center gap-1 transition-colors"
              >
                Bölgeyi İncele
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
              <a
                href={`https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(`Merhaba, ${district.name} bölgesinden adresten hurda alımı talep ediyorum.`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-all"
              >
                Araç Çağır
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
